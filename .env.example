# Postgres connection string.
#   Local:    `npm run db:up` starts Postgres in Docker at this URL.
#   Neon:     the pooled connection string (host contains "-pooler").
#   Supabase: the Session pooler connection string (Connect → Session pooler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/makemyneighborhood"

# Optional: a direct (non-pooled) connection used only for migrations.
#   Neon: the same string without "-pooler". Not needed for Supabase's session pooler.
# DIRECT_URL=""

# Photo storage in an S3-compatible bucket. Required in production.
# Leave unset locally and photos are saved to ./.uploads instead.
#   Supabase Storage: endpoint https://<project-ref>.supabase.co/storage/v1/s3, region = your project region
#   Cloudflare R2:    endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto"
# S3_BUCKET=""
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
